{
    "suggest.noselect": true,
    "coc.preferences.jumpCommand": "drop",
    "diagnostic.checkCurrentLine": false,
    "clangd.path": "~/.config/coc/extensions/coc-clangd-data/install/19.1.2/clangd_19.1.2/bin/clangd",
    "workspace.ignoredFolders": [
        "**/.git/**",
        "**/__pycache__/**"
    ],
    "workspace.rootPatterns": [
        ".git",
        "pyproject.toml"
    ],
    "python.analysis.diagnosticMode": "openFilesOnly",
    "clangd.path": "/usr/bin/clangd",
    "clangd.arguments": ["--background-index", "--clang-tidy"],
    "clangd.fallbackFlags": ["-std=c++23"]
}
